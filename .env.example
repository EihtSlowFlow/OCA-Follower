# CallMeBot WhatsApp Configuration
# Phone number in international format without '+' or spaces (e.g. 5491112345678)
CALLMEBOT_PHONE=+5491112345678

# Your private API key obtained from CallMeBot bot
CALLMEBOT_API_KEY=your_callmebot_api_key_here

# Database file path (relative or absolute)
TRACKER_DB_PATH=data/tracker.db

# Daemon Polling Interval in seconds (e.g. 900 = 15 minutes)
POLL_INTERVAL_SECONDS=1200

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Timeout for OCA HTTP/SOAP requests in seconds
OCA_TIMEOUT_SECONDS=15
